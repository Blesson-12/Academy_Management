MONGO_URL=your_mongodb_connection_string
SECRET_KEY=your_jwt_secret

# Twilio WhatsApp configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=918220492880

# Email notification settings
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM="Mizaph Academy <no-reply@example.com>"
ADMIN_EMAIL=admin@example.com

# SendGrid fallback / preferred provider
# Use SENDGRID_API_KEY if SMTP is blocked or unavailable in Render.
SENDGRID_API_KEY=your_sendgrid_api_key

# Optional mail timeout overrides (milliseconds)
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
